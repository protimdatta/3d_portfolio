# Required — Resend API key for the contact form
RESEND_API_KEY=your_resend_api_key
# Required — verified Resend sender, for example: Portfolio <hello@example.com>
RESEND_FROM_EMAIL=onboarding@resend.dev
# Required — inbox that receives contact form submissions
CONTACT_RECIPIENT_EMAIL=protim939@gmail.com

# Optional — WebSocket server URL for realtime features (live cursors, chat, presence)
# Leave empty to disable realtime features entirely
NEXT_PUBLIC_WS_URL=

# Realtime server settings
REALTIME_PORT=4000
REALTIME_ALLOWED_ORIGINS=https://3d-portfolio-drab-tau.vercel.app,http://localhost:3000,http://127.0.0.1:3000,http://192.168.0.100:3000
# Server-only admin settings. Never prefix these with NEXT_PUBLIC_.
REALTIME_ADMIN_PASSWORD=
REALTIME_ADMIN_NAME=Portfolio Admin
REALTIME_SESSION_SECRET=
 
# Optional — MongoDB Atlas persistence for realtime chat.
# Keep this server-only variable out of NEXT_PUBLIC_* values.
MONGODB_URI=YOUR_MONGODB_CONNECTION_STRING
MONGODB_DB_NAME=portfolio

# Optional — Umami analytics. Nothing loads unless UMAMI_SITE_ID is set.
# UMAMI_DOMAIN overrides the default script URL — set it if you self-host.
UMAMI_DOMAIN=
UMAMI_SITE_ID=

# Optional — Umami website id that /api/collect records deploy hostnames into.
# Unset = the endpoint only writes to the runtime log.
UMAMI_DEPLOY_SITE_ID=

# Optional — old domain you moved away from (e.g. example.site).
# When set, shows a one-time dismissible "we moved" notice. Leave empty.
NEXT_PUBLIC_LEGACY_HOST=
